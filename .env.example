# Copy to `.env` and adjust. `.env` is gitignored; this file is committed.
# Every variable here is validated by src/lib/env.ts at boot — the app refuses
# to start if one is missing or malformed, rather than failing later at runtime.

# Postgres connection string. Port 5433 matches compose.yaml, which avoids
# clashing with a Postgres you may already have on 5432.
DATABASE_URL="postgresql://myweblib:myweblib@localhost:5433/myweblib3?schema=public"

# Throwaway database used by integration tests (compose service `db-test`).
TEST_DATABASE_URL="postgresql://myweblib:myweblib@localhost:5434/myweblib3_test?schema=public"

# Secret used to derive CSRF tokens. Generate with:
#   openssl rand -base64 32
SESSION_SECRET="replace-me-with-at-least-32-characters-of-random-data"

# Where uploaded cover images are written in development.
UPLOAD_DIR="./uploads"

# Base URL of the app, used for absolute links in notification emails.
APP_URL="http://localhost:3000"

# Shared secret required by the cron-triggered overdue job at
# POST /api/jobs/overdue. Generate with: openssl rand -base64 32
CRON_SECRET="replace-me-too"

# "development" | "test" | "production"
NODE_ENV="development"

# Shadow database used by `prisma migrate dev` to diff the migration history.
# Required because migrations contain hand-written SQL.
SHADOW_DATABASE_URL="postgresql://myweblib:myweblib@localhost:5433/myweblib3_shadow?schema=public"
