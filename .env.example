# Copy to `.env` and adjust. `.env` is gitignored; this file is committed.
# Every variable here is validated by src/lib/env.ts at boot — the app refuses
# to start if one is missing or malformed, rather than failing later at runtime.

# Host ports for the two Postgres containers, read by compose.yaml. If another
# project on this machine wants one of them, change it here and in the port of
# the matching connection string below — both live in this file, so compose.yaml
# itself needs no edit. 15433/15434 rather than 5432/5433/5434, which are the
# ports every other Postgres on a dev box reaches for first.
DB_PORT="15433"
DB_TEST_PORT="15434"

# Postgres connection string. The port must match DB_PORT above.
DATABASE_URL="postgresql://myweblib:myweblib@localhost:15433/myweblib3?schema=public"

# Throwaway database used by integration tests (compose service `db-test`).
# The port must match DB_TEST_PORT above.
TEST_DATABASE_URL="postgresql://myweblib:myweblib@localhost:15434/myweblib3_test?schema=public"

# Secret used to derive CSRF tokens. Generate with:
#   openssl rand -base64 32
SESSION_SECRET="replace-me-with-at-least-32-characters-of-random-data"

# Where uploaded cover images are written in development.
UPLOAD_DIR="./uploads"

# Base URL of the app, used for absolute links in notification emails.
APP_URL="http://localhost:3000"

# Shared secret required by the cron-triggered overdue job at
# POST /api/jobs/overdue. Generate with: openssl rand -base64 32
CRON_SECRET="replace-me-too"

# "development" | "test" | "production"
NODE_ENV="development"

# Shadow database used by `prisma migrate dev` to diff the migration history.
# Required because migrations contain hand-written SQL. Same container as
# DATABASE_URL, so the port must match DB_PORT too.
SHADOW_DATABASE_URL="postgresql://myweblib:myweblib@localhost:15433/myweblib3_shadow?schema=public"
